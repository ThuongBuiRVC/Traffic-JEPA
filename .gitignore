/runs/
/clean_run/
submissions/submission_raw*
submissions/submission_final*
submissions/*_decoded.jsonl
submissions/*_cache.jsonl
submissions/caption_submission*.json
# python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
# os / editor
.DS_Store
*.swp

